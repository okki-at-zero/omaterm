#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL="$ROOT/install.sh"
NATIVE_INSTALL="$ROOT/install-native.sh"
DOCKER_INSTALL="$ROOT/install-docker.sh"

# shellcheck source=test/helpers
source "$(dirname "${BASH_SOURCE[0]}")/helpers"

[[ ! -e $NATIVE_INSTALL ]] ||
  fail "native installer should not exist"

[[ ! -e $DOCKER_INSTALL ]] ||
  fail "separate Docker installer should not exist"

grep -qF 'install_docker' "$INSTALL" ||
  fail "installer should run Docker installation directly"

grep -qF 'sudo apt-get install -y docker.io' "$INSTALL" ||
  fail "installer should install Docker packages directly"

grep -qF 'OMATERM_BIN_DIR=/usr/local/bin' "$INSTALL" ||
  fail "installer should put omaterm on the default system PATH"

grep -qF 'install -D -m 0755 "$tmp_file" "$dest"' "$INSTALL" ||
  fail "installer should overwrite the omaterm command in place"

grep -qF 'for file in omaterm omaterm-limits omaterm-templates omaterm-op' "$INSTALL" ||
  fail "installer should ship the omaterm libraries alongside the command"

grep -qF '/archive/refs/heads/' "$INSTALL" ||
  fail "installer should fetch the source tarball"

grep -qF 'OMATERM_SRC' "$INSTALL" ||
  fail "installer should stage the source checkout for the image build"

if grep -qF 'omacom-io/omaterm' "$INSTALL"; then
  fail "installer should not fetch from the retired upstream repo"
fi

if grep -qF 'omaterm.org' "$INSTALL"; then
  fail "installer should not use the dead omaterm.org domain"
fi

if grep -qE 'raw\.githubusercontent\.com/omacom|github\.com/omacom-io/omadots' "$ROOT/Dockerfile"; then
  fail "Dockerfile should install the vendored omadots, not fetch the retired upstream"
fi

if grep -qF '$HOME/.local/bin' "$INSTALL"; then
  fail "installer should not rely on a shell rc PATH change"
fi

if grep -qE 'install-native|install-docker|Install natively|run_installer' "$INSTALL"; then
  fail "installer should not delegate to another installer"
fi

grep -qF 'sudo groupadd -f docker' "$INSTALL" ||
  fail "installer should create the docker group"

grep -qF 'sudo usermod -aG docker "$target_user"' "$INSTALL" ||
  fail "installer should add the user to the docker group"

grep -qF 'exec sg docker -c omaterm' "$INSTALL" ||
  fail "installer should start omaterm from the docker group"

grep -qF 'docker info >/dev/null 2>&1' "$INSTALL" ||
  fail "installer should skip the group re-exec when docker already works"

grep -qF 'exec newgrp docker' "$INSTALL" ||
  fail "installer should fall back to newgrp where sg is missing"

grep -qF 'Starting omaterm...' "$INSTALL" ||
  fail "installer should start omaterm after install"

grep -qF 'install_gum' "$INSTALL" ||
  fail "installer should install gum"

grep -qF 'sudo pacman -S --needed --noconfirm gum' "$INSTALL" ||
  fail "installer should install gum on Arch"

grep -qF 'sudo dnf install -y gum' "$INSTALL" ||
  fail "installer should install gum on Fedora"

grep -qF 'repo.charm.sh' "$INSTALL" ||
  fail "installer should add Charm's apt repo for gum on Debian"

pass "installer installs gum across distros"

pass "installer is Docker-only"
